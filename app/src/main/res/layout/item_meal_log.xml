<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFoodName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frango Grelhado"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvMealType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ Almoço"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/lunch_color" />

            <TextView
                android:id="@+id/tvMacros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P: 30g | C: 20g | G: 5g"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_hint"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMealCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="350 kcal"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/accent"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <View
        android:id="@+id/btnDeleteMeal"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:drawable/ic_delete"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:tint="@color/error" />

</LinearLayout>
